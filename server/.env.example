# Configuracion del Servidor y Cliente
NODE_ENV=development
PORT=4050
CLIENT_PORT=4051

# Configuracion de CORS (en produccion indicar dominio real, ej. https://andrey1890.github.io)
CORS_ORIGIN=http://localhost:4050,http://127.0.0.1:4050,http://localhost:4051,http://127.0.0.1:4051,https://andrey1890.github.io
CORS_METHODS=GET,POST,PUT,PATCH,DELETE

# Configuracion de Paginacion y Seguridad (OWASP / JWT / Hash)
PAGINATION_LIMIT=100
HASH_SECRET_SALT=CAMBIAR_SALT_SECRETO_HASH
JWT_SECRET=CAMBIAR_SECRETO_JWT_2026
JWT_EXPIRES_IN=8h
API_PREFIX=/api/v1

# Capa 1: Base de Datos Supabase PostgreSQL (Prisma ORM + Pooler + PostgREST)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/postgres?sslmode=require&pgbouncer=true"
SUPABASE_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=CAMBIAR_USUARIO_SUPABASE
SUPABASE_PASSWORD=CAMBIAR_PASSWORD_SUPABASE
SUPABASE_REST_URL=https://TU_PROYECTO.supabase.co/rest/v1
SUPABASE_ANON_KEY=CAMBIAR_ANON_KEY_SUPABASE
