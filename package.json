{
  "name": "dermakor-fullstack-mvc",
  "version": "2.0.0",
  "description": "Plataforma Full Stack MVC DERMAKOR (Frontend GitHub Pages + Backend Express/Prisma en Vercel + Supabase PostgreSQL)",
  "main": "server/src/server.js",
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "start:client": "node server/cliente/serve-client.js",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "vercel-build": "prisma generate --schema=server/prisma/schema.prisma",
    "test": "node server/cliente/test-rest.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
